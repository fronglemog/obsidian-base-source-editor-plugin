{
  "name": "obsidian-base-source-editor-plugin",
  "version": "0.6.2",
  "author": "fronglemog",
  "license": "MIT",
  "type": "module",
  "main": "build/main.js",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.14.0"
    }
  },
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:dev": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "ts-check": "tsc -noEmit -skipLibCheck",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@codemirror/autocomplete": "6.20.0",
    "@codemirror/collab": "6.1.1",
    "@codemirror/commands": "6.8.1",
    "@codemirror/language": "6.12.1",
    "@codemirror/lint": "6.9.4",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@codemirror/lang-yaml": "6.1.3",
    "@lezer/common": "1.5.0",
    "@lezer/highlight": "1.2.3",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "globals": "17.13.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-tsdoc": "0.5.4",
    "eslint-plugin-unicorn": "78.0.0",
    "eslint-plugin-obsidianmd": "0.4.2",
    "typescript-eslint": "8.71.2",
    "typescript": "6.0.3",
    "tslib": "2.8.1",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "@obsidian-typings/obsidian-public-1.14.4": "1.13.0",
    "vitest": "5.0.5"
  }
}
